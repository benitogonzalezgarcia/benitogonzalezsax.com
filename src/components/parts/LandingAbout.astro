---
import type { LandingPageData } from '../../data/landingPages';
import { getLangFromUrl, useTranslations } from '../../i18n/utils';
import { stripSegmentAAccents } from '../../lib/typography';
import LandingAccordionSection from './LandingAccordionSection.astro';

interface Props {
  page: LandingPageData;
}

const { page } = Astro.props;
const t = useTranslations(getLangFromUrl(Astro.url));
---

<LandingAccordionSection id={t.nav.about.anchor} eyebrow={t.landing.about.eyebrow}>
  <section class="bg-white pb-20 pt-2">
    <div class="container mx-auto px-4">
      <div class="max-w-4xl">
        <h2 class="font-segmentA text-[3rem] font-bold uppercase tracking-[0.08em] text-primary md:text-[4.4rem]">
          {stripSegmentAAccents(page.introTitle)}
        </h2>
        <div class="mt-6 space-y-4 text-lg leading-8 text-gray-700">
          {page.introParagraphs.map((paragraph) => (
            <p>{paragraph}</p>
          ))}
        </div>
      </div>
    </div>
  </section>
</LandingAccordionSection>
