---
import { YouTube } from 'astro-embed';
import type { LandingPageData } from '../../data/landingPages';
import { getLangFromUrl, useTranslations } from '../../i18n/utils';
import { getYouTubePosterUrl } from '../../lib/embeds';
import { stripSegmentAAccents } from '../../lib/typography';

interface Props {
  page: LandingPageData;
}

const { page } = Astro.props;
const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const introDemoVideo = {
  title: t.landing.about.demoVideoTitle,
  url: 'https://www.youtube.com/shorts/-it5RoaROgU',
};

const introDemoPoster = getYouTubePosterUrl(introDemoVideo.url);
---

<section id={t.nav.about.anchor} class="bg-white py-20">
  <div class="container mx-auto grid gap-12 px-4 lg:grid-cols-[0.9fr_1.1fr] lg:items-center">
    <div class="aspect-[9/16] overflow-hidden rounded-[2rem] bg-primary/5 shadow-lg md:aspect-video">
      <YouTube
        id={introDemoVideo.url}
        title={introDemoVideo.title}
        playlabel={introDemoVideo.title}
        poster={introDemoPoster}
        class="embed-fill"
      />
    </div>
    <div>
      <p class="text-[0.98rem] font-semibold uppercase tracking-[0.24em] text-accent md:text-[1.12rem]">
        {t.landing.about.eyebrow}
      </p>
      <h2 class="mt-4 font-segmentA text-[3rem] font-bold uppercase tracking-[0.08em] text-primary md:text-[4.4rem]">
        {stripSegmentAAccents(page.introTitle)}
      </h2>
      <div class="mt-6 space-y-4 text-lg leading-8 text-gray-700">
        {page.introParagraphs.map((paragraph) => (
          <p>{paragraph}</p>
        ))}
      </div>
    </div>
  </div>
</section>
