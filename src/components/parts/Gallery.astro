---
import { Image } from "astro:assets";
import { YouTube } from "astro-embed";
import WeddingImage from "../../assets/gallery/sax-wedding.jpg";
import SportsMeetImage from "../../assets/gallery/sports-meet.jpg";
import BolnuevoImage from "../../assets/gallery/bolnuevo.jpg";
import BlamesImage from "../../assets/gallery/blames.jpg";
import FacebookIcon from "../../assets/icons/facebook.svg";
import InstagramIcon from "../../assets/icons/instagram.svg";
import YouTubeIcon from "../../assets/icons/youtube.svg";
import { FadeIn } from '../animations';
import { getLangFromUrl, useTranslations } from '../../i18n/utils';
import { BUSINESS } from '../../lib/site';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

type GalleryItem = {
  src: ImageMetadata | string;
  alt: string;
  type: "image" | "youtube";
};

const galleryItems: GalleryItem[] = [
  {
    src: WeddingImage,
    alt: t.gallery.items.weddingImageAlt,
    type: "image",
  },
  {
    src: SportsMeetImage,
    alt: t.gallery.items.sportsMeetImageAlt,
    type: "image",
  },
  {
    src: BolnuevoImage,
    alt: t.gallery.items.bolnuevoImageAlt,
    type: "image",
  },
  {
    src: BlamesImage,
    alt: t.gallery.items.blamesImageAlt,
    type: "image",
  },
  {
    src: "Ent8OtW2DKU",
    alt: t.gallery.items.flyingFreeAtWeddingYTAlt,
    type: "youtube",
  },
  {
    src: "hILiOtCMEBA",
    alt: t.gallery.items.destinationCalabriaAtWeddingYTAlt,
    type: "youtube",
  },
  {
    src: "Gq-AV9kIV-4",
    alt: t.gallery.items.titaniumDavidGuettaYTAlt,
    type: "youtube",
  },
  {
    src: "HsD3AflaXnk",
    alt: t.gallery.items.versionsAndHouseYTAlt,
    type: "youtube",
  },
];
--- 

<section id={t.nav.cities.anchor} class="py-20 bg-white">
  <div class="container mx-auto px-4">
    <div class="text-center mb-16">
      <h2
        class="font-segmentA uppercase tracking-wide text-6xl md:text-8xl font-bold mb-6 text-primary"
      >
        {t.gallery.title}
      </h2>
      <p class="text-lg text-black max-w-3xl mx-auto">
        {t.gallery.description}
      </p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
      {
        galleryItems.map((item, idx) => (
          <FadeIn delay={idx * 0.1} duration={0.6}>
            <div class="overflow-hidden rounded-lg shadow-md w-full h-full">
              {item.type === "image" && (
                <Image
                  src={item.src as ImageMetadata}
                  alt={item.alt}
                  class="object-cover w-full h-full transition-transform hover:scale-105"
                />
              )}
              {item.type === "youtube" && (
                <div class="relative h-96">
                  <YouTube id={item.src as string} class="absolute inset-0 w-full h-full" />
                </div>
              )}
            </div>
          </FadeIn>
        ))
      }
    </div>

    <div class="mt-12 text-center">
      <p class="text-lg text-black mb-6">
        {t.gallery.socialText}
      </p>
      <div class="flex justify-center space-x-6">
        <a
          href={BUSINESS.facebook}
          aria-label={t.gallery.facebookAriaLabel}
          class="text-primary hover:text-accent transition-colors"
        >
          <FacebookIcon />
        </a>
        <a
          href={BUSINESS.instagram}
          aria-label={t.gallery.instagramAriaLabel}
          class="text-primary hover:text-accent transition-colors"
        >
          <InstagramIcon />
        </a>
        <a
          href={BUSINESS.youtube}
          aria-label={t.gallery.youtubeAriaLabel}
          class="text-primary hover:text-accent transition-colors"
        >
          <YouTubeIcon />
        </a>
      </div>
    </div>
  </div>
</section>
