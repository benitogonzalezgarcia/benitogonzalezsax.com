---
import type { LandingPageData } from '../../data/landingPages';
import { getLangFromUrl, useTranslations } from '../../i18n/utils';
import { YouTube } from 'astro-embed';
import {
  getInstagramEmbedUrl,
  getYouTubePosterUrl,
  isYouTubeShort,
} from '../../lib/embeds';
import { stripSegmentAAccents } from '../../lib/typography';
import LandingAccordionSection from './LandingAccordionSection.astro';

interface Props {
  page: LandingPageData;
}

const { page } = Astro.props;
const t = useTranslations(getLangFromUrl(Astro.url));
---

<LandingAccordionSection id={t.landing.videos.anchor} eyebrow={t.landing.videos.eyebrow} open>
  <section class="bg-white pb-20 pt-2">
    <div class="container mx-auto px-4">
      <div class="max-w-3xl">
        <h2 class="font-segmentA text-[3.2rem] font-bold uppercase tracking-[0.08em] text-primary md:text-[4.4rem]">
          {stripSegmentAAccents(page.videosTitle)}
        </h2>
        <p class="mt-6 text-lg leading-8 text-gray-700">{page.videosIntro}</p>
      </div>

      <div class="mt-10 grid gap-6 lg:grid-cols-2">
        {page.videos.map((video) => {
          const isYouTube = video.platform === 'youtube';
          const isPortrait = isYouTube && isYouTubeShort(video.url);
          const instagramEmbedUrl = isYouTube ? null : getInstagramEmbedUrl(video.url);

          return (
            <article class="overflow-hidden rounded-[1.75rem] border border-gray-200 bg-gray-50 shadow-sm">
              <div
                class:list={[
                  'w-full bg-primary/5',
                  isPortrait ? 'mx-auto aspect-[9/16] max-w-[320px]' : 'aspect-video',
                ]}
              >
                {isYouTube ? (
                  <YouTube
                    id={video.url}
                    title={video.title}
                    playlabel={video.title}
                    poster={getYouTubePosterUrl(video.url)}
                    class="embed-fill"
                  />
                ) : instagramEmbedUrl ? (
                  <iframe
                    src={instagramEmbedUrl}
                    title={video.title}
                    class="h-full w-full"
                    loading="lazy"
                    allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
                    allowfullscreen
                  ></iframe>
                ) : (
                  <div class="flex h-full items-center justify-center p-6 text-center">
                    <a
                      href={video.url}
                      target="_blank"
                      rel="noreferrer"
                      class="text-sm font-semibold uppercase tracking-[0.14em] text-primary underline decoration-accent decoration-2 underline-offset-4"
                    >
                      {t.landing.videos.watchLabel}
                    </a>
                  </div>
                )}
              </div>
              <div class="p-6">
                <div class="flex items-center justify-between gap-4">
                  <h3 class="font-segmentA text-[2rem] font-bold uppercase tracking-[0.08em] text-primary md:text-[2.2rem]">
                    {stripSegmentAAccents(video.title)}
                  </h3>
                  <span class="rounded-full bg-primary px-3 py-1 text-xs font-semibold uppercase tracking-[0.14em] text-white">
                    {video.platform}
                  </span>
                </div>
                <p class="mt-3 text-base leading-7 text-gray-700">{video.description}</p>
              </div>
            </article>
          );
        })}
      </div>
    </div>
  </section>
</LandingAccordionSection>
