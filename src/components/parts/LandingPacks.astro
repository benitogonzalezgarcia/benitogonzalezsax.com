---
import type { LandingPageData } from '../../data/landingPages';
import { getLangFromUrl, useTranslations } from '../../i18n/utils';
import { euros } from '../../data/prices';
import { stripSegmentAAccents } from '../../lib/typography';
import LandingAccordionSection from './LandingAccordionSection.astro';

interface Props {
  page: LandingPageData;
}

const { page } = Astro.props;
const t = useTranslations(getLangFromUrl(Astro.url));
---

<LandingAccordionSection id="packs" eyebrow={t.landing.packs.eyebrow}>
  <section class="bg-white pb-20 pt-2">
    <div class="container mx-auto px-4">
      <div class="max-w-2xl">
        <h2 class="font-segmentA text-[3rem] font-bold uppercase tracking-[0.08em] text-primary md:text-[4.4rem]">
          {stripSegmentAAccents(page.packsTitle)}
        </h2>
        <p class="mt-6 max-w-xl text-lg leading-8 text-gray-700">{page.packsIntro}</p>
      </div>

      <div class="mt-10 grid max-w-3xl gap-6 lg:max-w-none lg:grid-cols-2">
        {page.packs.map((pack, index) => (
          <article
            class:list={[
              'rounded-[1.9rem] border p-6 shadow-sm md:p-7',
              index === 0
                ? 'border-accent/40 bg-primary text-white'
                : 'border-gray-200 bg-gray-50 text-gray-900',
            ]}
          >
            <div class="flex flex-col gap-4 sm:flex-row sm:items-start sm:justify-between">
              <div>
                <p class="text-[0.9rem] font-semibold uppercase tracking-[0.24em] text-accent">
                  {index === 0 ? t.landing.packs.recommendedLabel : t.landing.packs.flexibleLabel}
                </p>
                <div class="mt-4 flex flex-wrap items-center gap-3">
                  <h3
                    class:list={[
                      'font-segmentA text-[2.5rem] font-bold uppercase tracking-[0.08em] md:text-[3rem]',
                      index === 0 ? 'text-white' : 'text-primary',
                    ]}
                  >
                    {stripSegmentAAccents(pack.name)}
                  </h3>
                  <span
                    class:list={[
                      'hidden rounded-full px-4 py-2 text-xs font-semibold uppercase tracking-[0.18em] sm:inline-flex',
                      index === 0 ? 'bg-white/10 text-white' : 'bg-primary/8 text-primary',
                    ]}
                  >
                    {index === 0 ? t.landing.packs.morePersonalisationLabel : t.landing.packs.moreDirectLabel}
                  </span>
                </div>
                {pack.priceEstimate && (
                  <p
                    class:list={[
                      'mt-4 text-2xl font-semibold tracking-tight',
                      index === 0 ? 'text-accent' : 'text-primary',
                    ]}
                  >
                    {pack.priceEstimate}
                  </p>
                )}
              </div>
            </div>

            <ul class="mt-6 space-y-4">
              {pack.bullets.map((bullet) => (
                <li class="flex gap-3">
                  <span class="mt-2 h-2.5 w-2.5 shrink-0 rounded-full bg-accent"></span>
                  <span class:list={[
                    'text-base leading-7',
                    index === 0 ? 'text-white/85' : 'text-gray-700',
                  ]}>
                    {bullet}
                  </span>
                </li>
              ))}
            </ul>
          </article>
        ))}
      </div>

      {page.priceRows && (
      <div class="mt-8 overflow-hidden rounded-[1.9rem] border border-gray-200 bg-gray-50 p-6 shadow-sm md:p-7">
        <table class="w-full text-left">
          <caption class="sr-only">{t.landing.packs.tableCaption}</caption>
          <thead>
            <tr class="text-[0.78rem] font-semibold uppercase tracking-[0.16em] text-accent md:text-[0.9rem] md:tracking-[0.24em]">
              <th scope="col" class="pb-4 pr-3">{t.landing.packs.momentLabel}</th>
              <th scope="col" class="pb-4 pr-3 text-right">{t.landing.packs.basicLabel}</th>
              <th scope="col" class="pb-4 text-right">{t.landing.packs.premiumLabel}</th>
            </tr>
          </thead>
          <tbody>
            {page.priceRows.map((row) => (
              <tr class="border-t border-gray-200">
                <th scope="row" class="py-3 pr-3 text-base font-normal leading-6 text-gray-700">
                  {row.moment}
                  {row.duration && <span class="block text-sm text-gray-500">{row.duration}</span>}
                </th>
                <td class="whitespace-nowrap py-3 pr-3 text-right text-lg font-semibold text-primary">{euros(row.basic)}</td>
                <td class="whitespace-nowrap py-3 text-right text-lg font-semibold text-primary">{euros(row.premium)}</td>
              </tr>
            ))}
          </tbody>
        </table>

        <ul class="mt-6 space-y-3">
          {page.priceNotes?.map((note) => (
            <li class="flex gap-3">
              <span class="mt-2 h-2.5 w-2.5 shrink-0 rounded-full bg-accent"></span>
              <span class="text-base leading-7 text-gray-700">{note}</span>
            </li>
          ))}
        </ul>
      </div>
      )}
    </div>
  </section>
</LandingAccordionSection>
